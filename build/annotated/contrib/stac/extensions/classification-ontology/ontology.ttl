@prefix classification: <https://w3id.org/ogc/stac/classification/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

classification:bitfields a owl:ObjectProperty ;
    rdfs:label "classification bitfields" ;
    dct:description "A list of bit fields (classes stored in fields of continuous bits within the pixel's value)." ;
    rdfs:isDefinedBy classification: ;
    rdfs:range classification:BitField .

classification:classes a owl:ObjectProperty ;
    rdfs:label "classification classes" ;
    dct:description "A list of classes (a codelist) contained in the data, where one or more unique coded integer values are present within a raster asset or band." ;
    rdfs:isDefinedBy classification: ;
    rdfs:range classification:Class .

classification:color_hint a owl:DatatypeProperty ;
    rdfs:label "class color hint" ;
    dct:description "A hint for a legend/visualization color: six hexadecimal characters, either lower or upper case, without a leading '#'." ;
    rdfs:domain classification:Class ;
    rdfs:isDefinedBy classification: ;
    rdfs:range xsd:string .

classification:count a owl:DatatypeProperty ;
    rdfs:label "class count" ;
    dct:description "The number of pixels/values in the file that belong to this class." ;
    rdfs:domain classification:Class ;
    rdfs:isDefinedBy classification: ;
    rdfs:range xsd:nonNegativeInteger .

classification:description a owl:DatatypeProperty ;
    rdfs:label "class/bitfield description" ;
    dct:description "A longer, human-readable explanation (supports CommonMark 0.29). The same property is used on both a Class Object and a Bit Field Object." ;
    rdfs:domain [ owl:unionOf ( classification:Class classification:BitField ) ] ;
    rdfs:isDefinedBy classification: ;
    rdfs:subPropertyOf skos:definition .

classification:length a owl:DatatypeProperty ;
    rdfs:label "bit field length" ;
    dct:description "REQUIRED. Number of bits in the field." ;
    rdfs:domain classification:BitField ;
    rdfs:isDefinedBy classification: ;
    rdfs:range xsd:positiveInteger .

classification:name a owl:DatatypeProperty ;
    rdfs:label "class/bitfield name" ;
    dct:description "REQUIRED on Class Object. The machine-readable name, restricted to letters, numbers, '-' and '_'. The same property/pattern names a Bit Field Object (there, optional)." ;
    rdfs:domain [ owl:unionOf ( classification:Class classification:BitField ) ] ;
    rdfs:isDefinedBy classification: ;
    rdfs:subPropertyOf skos:altLabel .

classification:nodata a owl:DatatypeProperty ;
    rdfs:label "class is nodata" ;
    dct:description "Whether the value in this class represents missing data (nodata). Defaults to false when absent." ;
    rdfs:domain classification:Class ;
    rdfs:isDefinedBy classification: ;
    rdfs:range xsd:boolean .

classification:offset a owl:DatatypeProperty ;
    rdfs:label "bit field offset" ;
    dct:description "REQUIRED. Position of the first (least significant, rightmost) bit of the field." ;
    rdfs:domain classification:BitField ;
    rdfs:isDefinedBy classification: ;
    rdfs:range xsd:nonNegativeInteger .

classification:percentage a owl:DatatypeProperty ;
    rdfs:label "class percentage" ;
    dct:description "The percentage of the values in the file that belong to this class, between 0 and 100." ;
    rdfs:domain classification:Class ;
    rdfs:isDefinedBy classification: ;
    rdfs:range xsd:double .

classification:roles a owl:DatatypeProperty ;
    rdfs:label "bit field roles" ;
    dct:description "Semantic roles (STAC asset roles) that further specify the purpose of the bit field." ;
    rdfs:domain classification:BitField ;
    rdfs:isDefinedBy classification: ;
    rdfs:range xsd:string .

classification:title a owl:DatatypeProperty ;
    rdfs:label "class title" ;
    dct:description "The human-readable name for use in a legend or user interface, distinct from the machine-readable classification:name." ;
    rdfs:domain classification:Class ;
    rdfs:isDefinedBy classification: ;
    rdfs:subPropertyOf skos:prefLabel .

classification:value a owl:DatatypeProperty ;
    rdfs:label "class value" ;
    dct:description "REQUIRED. The value used for the class in the file, as an integer or bit value." ;
    rdfs:domain classification:Class ;
    rdfs:isDefinedBy classification: ;
    rdfs:subPropertyOf skos:notation .

classification:BitField a owl:Class ;
    rdfs:label "classification bit field" ;
    dct:description "A field of continuous bits within a pixel's value (a bit mask / bit index) whose bit-integer combinations represent classes." ;
    rdfs:isDefinedBy classification: .

classification:Class a owl:Class ;
    rdfs:label "classification class" ;
    dct:description "One coded value (a 'Class Object') within a classification:classes or classification:bitfields[].classes codelist, translating a coded integer value to a human-readable class of data." ;
    rdfs:isDefinedBy classification: ;
    rdfs:subClassOf skos:Concept .

classification: a owl:Ontology ;
    dct:creator "Rob Atkinson, OGC" ;
    dct:description """Vocabulary for the elements defined by the STAC Classification extension: codelists that translate coded integer/bitfield values in raster assets and bands into human-readable data classes.

This ontology describes only the classification:* fields that the extension adds. STAC Item, Collection and Asset are defined by the STAC core vocabulary and are reused — not redefined — here.

Combines skos.ttl (classification:Class as a skos:Concept, and its lexical properties value/name/title/description) and owl.ttl (the codelist container properties, classification:BitField, and per-class statistics that carry no SKOS meaning).""" ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:source <https://github.com/stac-extensions/classification/tree/v2.0.0> ;
    dct:title "STAC Classification Extension Ontology" ;
    owl:versionInfo "2.0.0" .

