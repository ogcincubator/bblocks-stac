@prefix dct: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.iana.org/assignments/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix stac: <https://w3id.org/ogc/stac/core/> .

<file:///github/workspace/examples> a stac:Catalog ;
    dct:description "This catalog is a simple demonstration of an example catalog that is used to organize a hierarchy of collections and their items." ;
    dct:title "Example Catalog" ;
    rdfs:seeAlso [ rdfs:label "Collection with no items (standalone with JSON Schemas)" ;
            dct:type "application/json" ;
            ns1:relation <http://www.iana.org/assignments/relation/child> ;
            oa:hasTarget <file:///github/workspace/collection-only/collection-with-schemas.json> ],
        [ rdfs:label "Collection with no items (standalone)" ;
            dct:type "application/json" ;
            ns1:relation <http://www.iana.org/assignments/relation/item> ;
            oa:hasTarget <file:///github/workspace/collectionless-item.json> ],
        [ rdfs:label "Collection with no items (standalone)" ;
            dct:type "application/json" ;
            ns1:relation <http://www.iana.org/assignments/relation/child> ;
            oa:hasTarget <file:///github/workspace/collection-only/collection.json> ],
        [ rdfs:label "Collection Demonstrating STAC Extensions" ;
            dct:type "application/json" ;
            ns1:relation <http://www.iana.org/assignments/relation/child> ;
            oa:hasTarget <file:///github/workspace/extensions-collection/collection.json> ],
        [ dct:type "application/json" ;
            ns1:relation <http://www.iana.org/assignments/relation/root> ;
            oa:hasTarget <file:///github/workspace/catalog.json> ],
        [ dct:type "application/json" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            oa:hasTarget <https://raw.githubusercontent.com/radiantearth/stac-spec/v1.0.0/examples/catalog.json> ] ;
    stac:version "1.0.0" .

