ex:landsat-item a stac:Item ;
    eo:cloud_cover 1.25e+01 ;
    eo:snow_cover 0e+00 .

ex:red-band eo:center_wavelength 6.55e-01 ;
    eo:common_name eo:red ;
    eo:full_width_half_max 7e-02 .

