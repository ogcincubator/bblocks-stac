<bblocks://ogc.contrib.stac.extensions.mlm-ontology> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "STAC Machine Learning Model Extension Ontology" ;
    dct:created "2026-08-25T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-stac/bblock/ogc.contrib.stac.extensions.mlm-ontology> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-stac/build/generateddocs/json-full/contrib/stac/extensions/mlm-ontology/index.json> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-stac/build/generateddocs/markdown/contrib/stac/extensions/mlm-ontology/index.md> ],
        "Vocabulary defining the elements of the STAC Machine Learning Model (MLM) extension: model identity, framework/accelerator requirements, and the ModelInput/ModelOutput/InputStructure/ResultStructure/ValueScaling structures, providing Linked Data terms for the STAC MLM schema. Tasks, framework, accelerator, resize_type and value-scaling type are modeled as skos:ConceptSchemes; everything else stays OWL. Reuses classification:classes (Classification extension) and aligns with processing:expression (Processing extension) rather than redefining them."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-08-25"^^xsd:date ;
    dct:source <https://github.com/stac-extensions/mlm>,
        <https://github.com/stac-extensions/mlm/blob/main/README.md>,
        <https://stac-extensions.github.io/mlm/v1.5.2/schema.json> ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-stac/> ;
    skos:prefLabel "STAC Machine Learning Model Extension Ontology" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-stac/> ;
    prof:hasResource [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.contrib.stac.extensions.mlm-ontology> ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/_sources/extensions/mlm-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo owl:Ontology ;
            dct:format "text/turtle" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/build/annotated/contrib/stac/extensions/mlm-ontology/ontology.ttl> ;
            prof:hasRole role:specification ] ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

<bblocks://ogc.contrib.stac.extensions.osc-ontology> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "STAC Open Science Extension Ontology" ;
    dct:created "2025-06-12T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-stac/bblock/ogc.contrib.stac.extensions.osc-ontology> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-stac/build/generateddocs/markdown/contrib/stac/extensions/osc-ontology/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-stac/build/generateddocs/json-full/contrib/stac/extensions/osc-ontology/index.json> ],
        "Vocabulary defining the elements of the STAC ESA Open Science Catalog (OSC) extension (osc:type, osc:status, osc:project, osc:region, osc:variables, osc:missions, osc:experiment, osc:workflows), providing Linked Data terms for the STAC OSC schema. osc:type and osc:status are modeled as skos:ConceptSchemes; the remaining free-text fields stay OWL. Replaces an earlier placeholder that incorrectly reused the STAC core ontology's namespace and described none of OSC's own elements."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "0.2" ;
    dct:modified "2026-08-25"^^xsd:date ;
    dct:source <https://github.com/stac-extensions/osc>,
        <https://github.com/stac-extensions/osc/blob/main/README.md>,
        <https://stac-extensions.github.io/osc/v1.0.0/schema.json> ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-stac/> ;
    skos:prefLabel "STAC Open Science Extension Ontology" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-stac/> ;
    prof:hasResource [ dct:conformsTo owl:Ontology ;
            dct:format "text/turtle" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/build/annotated/contrib/stac/extensions/osc-ontology/ontology.ttl> ;
            prof:hasRole role:specification ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.contrib.stac.extensions.osc-ontology> ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/_sources/extensions/osc-ontology/shapes.shacl> ;
            prof:hasRole role:validation ] ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

<bblocks://ogc.contrib.stac.extensions.themes-ontology> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "STAC Themes Extension Ontology" ;
    dct:created "2026-08-25T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-stac/build/generateddocs/markdown/contrib/stac/extensions/themes-ontology/index.md> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-stac/bblock/ogc.contrib.stac.extensions.themes-ontology> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-stac/build/generateddocs/json-full/contrib/stac/extensions/themes-ontology/index.json> ],
        "Vocabulary defining the elements of the STAC Themes extension (thns:schemes, thns:scheme, thns:concepts, and the Concept Object fields thns:id/thns:name/thns:description), providing Linked Data terms for the STAC Themes schema and for the osc schema block, which reuses this namespace. thns:Concept is modeled as a skos:Concept subclass; thns:Theme and the structural properties stay OWL. Preserves pre-existing thns:* term IRIs already relied on by themes-shacl's SPARQL rules."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-08-25"^^xsd:date ;
    dct:source <https://github.com/stac-extensions/themes>,
        <https://github.com/stac-extensions/themes/blob/main/README.md>,
        <https://stac-extensions.github.io/themes/v1.0.0/schema.json> ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-stac/> ;
    skos:prefLabel "STAC Themes Extension Ontology" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-stac/> ;
    prof:hasResource [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.contrib.stac.extensions.themes-ontology> ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/_sources/extensions/themes-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo owl:Ontology ;
            dct:format "text/turtle" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/build/annotated/contrib/stac/extensions/themes-ontology/ontology.ttl> ;
            prof:hasRole role:specification ] ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

