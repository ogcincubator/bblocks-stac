<bblocks://ogc.contrib.stac.components.assets-ontology> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "STAC Asset Component Ontology" ;
    dct:created "2026-08-25T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-stac/bblock/ogc.contrib.stac.components.assets-ontology> ],
        [ dct:format "text/markdown" ;
