<bblocks://ogc.contrib.stac.extensions.accuracy-ontology> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "STAC Accuracy Extension Ontology" ;
    dct:created "2026-08-25T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-stac/build/generateddocs/markdown/contrib/stac/extensions/accuracy-ontology/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-stac/build/generateddocs/json-full/contrib/stac/extensions/accuracy-ontology/index.json> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-stac/bblock/ogc.contrib.stac.extensions.accuracy-ontology> ],
        "Vocabulary defining the elements of the STAC Accuracy extension (accuracy:geometric_x_bias, accuracy:geometric_y_bias, accuracy:geometric_x_stddev, accuracy:geometric_y_stddev, accuracy:geometric_rmse, accuracy:measurement_relative and accuracy:measurement_absolute), providing Linked Data terms for the STAC Accuracy schema. Reuses STAC core classes rather than redefining them. No enumerated values are defined by the extension, so this block has no SKOS component."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-08-25"^^xsd:date ;
    dct:source <https://github.com/stac-extensions/accuracy>,
        <https://github.com/stac-extensions/accuracy/blob/main/README.md>,
        <https://stac-extensions.github.io/accuracy/v1.0.0-beta.1/schema.json> ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-stac/> ;
    skos:prefLabel "STAC Accuracy Extension Ontology" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-stac/> ;
    prof:hasResource [ dct:conformsTo owl:Ontology ;
            dct:format "text/turtle" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/build/annotated/contrib/stac/extensions/accuracy-ontology/ontology.ttl> ;
            prof:hasRole role:specification ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.contrib.stac.extensions.accuracy-ontology> ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/_sources/extensions/accuracy-ontology/shapes.shacl> ;
            prof:hasRole role:validation ] ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

