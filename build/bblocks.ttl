            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-stac/build/generateddocs/json-full/contrib/stac/components/assets-ontology/index.json> ],
        "Vocabulary for the STAC Asset Object component: assets:roles, with recommended values drawn from the STAC specification's best-practice Asset Roles vocabulary (assets:AssetRoleScheme, a skos:ConceptScheme). The Asset Object's other fields (href, title, description, type) are reused from JSON-LD @id, dct:title, dct:description and dct:format; stac:Asset/stac:hasAsset are reused from the STAC core ontology, not redefined."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-08-25"^^xsd:date ;
    dct:source <https://github.com/radiantearth/stac-spec/blob/master/best-practices.md#asset-roles>,
