        <https://stacspec.org/en/about/stac-spec/> ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-stac/> ;
    skos:prefLabel "STAC Asset Component Ontology" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-stac/> ;
    prof:hasResource [ dct:conformsTo owl:Ontology ;
            dct:format "text/turtle" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/build/annotated/contrib/stac/components/assets-ontology/ontology.ttl> ;
            prof:hasRole role:specification ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.contrib.stac.components.assets-ontology> ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/_sources/components/assets-ontology/shapes.shacl> ;
            prof:hasRole role:validation ] ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

