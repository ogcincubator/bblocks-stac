    dct:hasVersion "1.0.0" ;
    dct:modified "2026-08-25"^^xsd:date ;
    dct:source <https://stacspec.org/en/about/stac-spec/> ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-stac/> ;
    skos:prefLabel "STAC Collection (v1.0.0)" ;
