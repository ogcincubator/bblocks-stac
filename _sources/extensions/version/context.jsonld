{
  "@context": {
    "ver": "https://w3id.org/ogc/stac/version/",
    "version": { "@id": "ver:version", "@type": "xsd:string" },
    "deprecated": { "@id": "ver:deprecated", "@type": "xsd:boolean" },
    "experimental": { "@id": "ver:experimental", "@type": "xsd:boolean" },
    "latest-version": { "@id": "ver:latest-version", "@type": "@id" },
    "predecessor-version": { "@id": "ver:predecessor-version", "@type": "@id" },
    "successor-version": { "@id": "ver:successor-version", "@type": "@id" },
    "version-history": { "@id": "ver:version-history", "@type": "@id" },
    "has-version": { "@id": "ver:has-version", "@type": "@id" },
    "is-version-of": { "@id": "ver:is-version-of", "@type": "@id" }
  }
}
