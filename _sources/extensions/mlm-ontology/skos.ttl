@prefix mlm:  <https://w3id.org/ogc/stac/mlm/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
# SKOS component — the MLM extension's fixed/recommended enumerations.
# mlm:framework is a RECOMMENDED, extensible list (the extension's JSON Schema
# also accepts any other string) — its scheme is marked as non-exhaustive.
# The others (tasks, accelerator, resize_type, value-scaling type) are closed.
#
# The extension's schema/README give the enum lists themselves but no per-value
# prose (task/framework/accelerator/resize-type/scaling-type names are standard
# ML/CS terminology, not phrases the extension defines). skos:definition below
# is therefore a faithful, minimal statement of each term's standard meaning,
# not a copied spec sentence — there is no such sentence to copy. Where the
# extension's own worked examples (stac-extensions/mlm and stac-extensions/
# classification repos) show a concrete real-world use, skos:example cites it;
# concepts with no such worked example in view carry none, rather than an
# invented one.
#################################################################

### mlm:tasks — closed

mlm:TaskScheme a skos:ConceptScheme ;
    dct:title "MLM Tasks" ;
    dct:description "The machine learning task types a model may support, as defined by the STAC MLM extension." ;
    rdfs:isDefinedBy mlm: .

mlm:regression a skos:Concept ; skos:inScheme mlm:TaskScheme ; skos:notation "regression" ; skos:prefLabel "Regression"@en ;
    skos:definition "Predicting a continuous numeric value from input data."@en .
mlm:classification a skos:Concept ; skos:inScheme mlm:TaskScheme ; skos:notation "classification" ; skos:prefLabel "Classification"@en ;
    skos:definition "Assigning one or more discrete class labels to the input as a whole."@en ;
    skos:example "example-model, in the extension's own item_basic.json example, uses mlm:tasks = classification."@en .
mlm:scene-classification a skos:Concept ; skos:inScheme mlm:TaskScheme ; skos:notation "scene-classification" ; skos:prefLabel "Scene classification"@en ;
    skos:definition "Assigning a single class label that characterizes an entire scene/image, as opposed to per-pixel classification."@en ;
    skos:example "resnet-18_sentinel-2_all_moco_classification, in the extension's own examples, uses mlm:tasks = scene-classification."@en .
mlm:detection a skos:Concept ; skos:inScheme mlm:TaskScheme ; skos:notation "detection" ; skos:prefLabel "Detection"@en ;
    skos:definition "Identifying the presence and location of instances of interest in the input, without necessarily classifying them."@en .
mlm:object-detection a skos:Concept ; skos:inScheme mlm:TaskScheme ; skos:notation "object-detection" ; skos:prefLabel "Object detection"@en ;
    skos:definition "Identifying and localizing (typically with bounding boxes) instances of one or more object classes in the input."@en .
mlm:segmentation a skos:Concept ; skos:inScheme mlm:TaskScheme ; skos:notation "segmentation" ; skos:prefLabel "Segmentation"@en ;
    skos:definition "Partitioning the input into regions, typically by assigning a label to each pixel."@en .
mlm:semantic-segmentation a skos:Concept ; skos:inScheme mlm:TaskScheme ; skos:notation "semantic-segmentation" ; skos:prefLabel "Semantic segmentation"@en ;
    skos:definition "Assigning a class label to every pixel of the input, without distinguishing between separate instances of the same class."@en ;
    skos:example "pytorch_geo_unet, in the extension's own examples, uses mlm:tasks = semantic-segmentation."@en .
mlm:instance-segmentation a skos:Concept ; skos:inScheme mlm:TaskScheme ; skos:notation "instance-segmentation" ; skos:prefLabel "Instance segmentation"@en ;
    skos:definition "Assigning a class label to every pixel while also distinguishing separate instances of the same class from one another."@en .
mlm:panoptic-segmentation a skos:Concept ; skos:inScheme mlm:TaskScheme ; skos:notation "panoptic-segmentation" ; skos:prefLabel "Panoptic segmentation"@en ;
    skos:definition "A combination of semantic and instance segmentation: every pixel gets a class label, and countable ('thing') classes are further split into individual instances."@en .
mlm:similarity-search a skos:Concept ; skos:inScheme mlm:TaskScheme ; skos:notation "similarity-search" ; skos:prefLabel "Similarity search"@en ;
    skos:definition "Producing a representation (embedding) of the input suitable for retrieving other inputs that are similar to it."@en .
mlm:generative a skos:Concept ; skos:inScheme mlm:TaskScheme ; skos:notation "generative" ; skos:prefLabel "Generative"@en ;
    skos:definition "Synthesizing new data (e.g. imagery) rather than labeling or measuring existing input."@en .
mlm:image-captioning a skos:Concept ; skos:inScheme mlm:TaskScheme ; skos:notation "image-captioning" ; skos:prefLabel "Image captioning"@en ;
    skos:definition "Generating a natural-language text description of the input image."@en .
mlm:super-resolution a skos:Concept ; skos:inScheme mlm:TaskScheme ; skos:notation "super-resolution" ; skos:prefLabel "Super-resolution"@en ;
    skos:definition "Producing a higher spatial-resolution output from lower spatial-resolution input."@en .
mlm:downscaling a skos:Concept ; skos:inScheme mlm:TaskScheme ; skos:notation "downscaling" ; skos:prefLabel "Downscaling"@en ;
    skos:definition "Producing finer-grained (e.g. higher spatial or temporal resolution) output from coarser-grained input, typically used for climate/weather variables."@en ;
    skos:example "UNet_ClimateDiffuse_ERA5_Downscaling, in the extension's own examples, uses mlm:tasks = downscaling."@en .

### mlm:framework — recommended, open (extension also allows other free-text values)

mlm:FrameworkScheme a skos:ConceptScheme ;
    dct:title "MLM Frameworks" ;
    dct:description "Recommended values for the ML framework used to train/run a model, as listed by the STAC MLM extension. The extension also accepts any other framework name as free text; this scheme is not exhaustive." ;
    rdfs:isDefinedBy mlm: .

mlm:PyTorch a skos:Concept ; skos:inScheme mlm:FrameworkScheme ; skos:notation "PyTorch" ; skos:prefLabel "PyTorch"@en ;
    skos:definition "An open-source deep learning framework providing tensor computation and automatic differentiation, originally developed by Meta AI."@en ;
    skos:example "The extension's own README example sets mlm:framework = \"PyTorch\" (with mlm:framework_version \"2.1.2\")."@en .
mlm:TensorFlow a skos:Concept ; skos:inScheme mlm:FrameworkScheme ; skos:notation "TensorFlow" ; skos:prefLabel "TensorFlow"@en ;
    skos:definition "An open-source deep learning framework originally developed by Google."@en .
mlm:scikit-learn a skos:Concept ; skos:inScheme mlm:FrameworkScheme ; skos:notation "scikit-learn" ; skos:prefLabel "scikit-learn"@en ;
    skos:definition "An open-source Python library for classical (non-deep-learning) machine learning."@en .
mlm:hugging-face a skos:Concept ; skos:inScheme mlm:FrameworkScheme ; skos:notation "Hugging Face" ; skos:prefLabel "Hugging Face"@en ;
    skos:definition "The Hugging Face Transformers ecosystem/library for pretrained machine learning models."@en .
mlm:Keras a skos:Concept ; skos:inScheme mlm:FrameworkScheme ; skos:notation "Keras" ; skos:prefLabel "Keras"@en ;
    skos:definition "A high-level deep learning API, usable on top of TensorFlow, JAX or PyTorch."@en .
mlm:ONNX a skos:Concept ; skos:inScheme mlm:FrameworkScheme ; skos:notation "ONNX" ; skos:prefLabel "ONNX"@en ;
    skos:definition "Open Neural Network Exchange: an open format and runtime for representing and running trained machine learning models across frameworks."@en .
mlm:rgee a skos:Concept ; skos:inScheme mlm:FrameworkScheme ; skos:notation "rgee" ; skos:prefLabel "rgee"@en ;
    skos:definition "An R package providing bindings to Google Earth Engine."@en .
mlm:spatialRF a skos:Concept ; skos:inScheme mlm:FrameworkScheme ; skos:notation "spatialRF" ; skos:prefLabel "spatialRF"@en ;
    skos:definition "An R package for fitting spatial random forest models."@en .
mlm:JAX a skos:Concept ; skos:inScheme mlm:FrameworkScheme ; skos:notation "JAX" ; skos:prefLabel "JAX"@en ;
    skos:definition "A Python library for high-performance numerical computing and automatic differentiation, developed by Google."@en .
mlm:Flax a skos:Concept ; skos:inScheme mlm:FrameworkScheme ; skos:notation "Flax" ; skos:prefLabel "Flax"@en ;
    skos:definition "A neural network library built on top of JAX."@en .
mlm:MXNet a skos:Concept ; skos:inScheme mlm:FrameworkScheme ; skos:notation "MXNet" ; skos:prefLabel "MXNet"@en ;
    skos:definition "An open-source deep learning framework, an Apache Software Foundation project."@en .
mlm:Caffe a skos:Concept ; skos:inScheme mlm:FrameworkScheme ; skos:notation "Caffe" ; skos:prefLabel "Caffe"@en ;
    skos:definition "A deep learning framework originally developed at UC Berkeley, focused on convolutional neural networks."@en .
mlm:PyMC a skos:Concept ; skos:inScheme mlm:FrameworkScheme ; skos:notation "PyMC" ; skos:prefLabel "PyMC"@en ;
    skos:definition "A Python library for Bayesian statistical modeling and probabilistic programming."@en .
mlm:Weka a skos:Concept ; skos:inScheme mlm:FrameworkScheme ; skos:notation "Weka" ; skos:prefLabel "Weka"@en ;
    skos:definition "A Java-based collection of machine learning algorithms and tools, developed at the University of Waikato."@en .
mlm:Paddle a skos:Concept ; skos:inScheme mlm:FrameworkScheme ; skos:notation "Paddle" ; skos:prefLabel "Paddle"@en ;
    skos:definition "PaddlePaddle: an open-source deep learning framework developed by Baidu."@en .

### mlm:accelerator — closed (the extension also allows the JSON value null, meaning "no accelerator")

mlm:AcceleratorScheme a skos:ConceptScheme ;
    dct:title "MLM Accelerators" ;
    dct:description "The hardware accelerator types a model may require or target, as defined by the STAC MLM extension." ;
    rdfs:isDefinedBy mlm: .

mlm:amd64 a skos:Concept ; skos:inScheme mlm:AcceleratorScheme ; skos:notation "amd64" ; skos:prefLabel "amd64 (CPU only)"@en ;
    skos:definition "Standard x86-64 CPU execution, with no dedicated hardware accelerator."@en .
mlm:cuda a skos:Concept ; skos:inScheme mlm:AcceleratorScheme ; skos:notation "cuda" ; skos:prefLabel "NVIDIA CUDA"@en ;
    skos:definition "NVIDIA's CUDA parallel computing platform, used to run models on NVIDIA GPUs."@en ;
    skos:example "The extension's own README example sets mlm:accelerator = \"cuda\"."@en .
mlm:xla a skos:Concept ; skos:inScheme mlm:AcceleratorScheme ; skos:notation "xla" ; skos:prefLabel "XLA"@en ;
    skos:definition "Accelerated Linear Algebra: a compiler for linear algebra that can target CPUs, GPUs and TPUs, used by TensorFlow/JAX."@en .
mlm:amd-rocm a skos:Concept ; skos:inScheme mlm:AcceleratorScheme ; skos:notation "amd-rocm" ; skos:prefLabel "AMD ROCm"@en ;
    skos:definition "AMD's ROCm open software platform for running compute workloads on AMD GPUs."@en .
mlm:intel-ipex-cpu a skos:Concept ; skos:inScheme mlm:AcceleratorScheme ; skos:notation "intel-ipex-cpu" ; skos:prefLabel "Intel IPEX (CPU)"@en ;
    skos:definition "Intel Extension for PyTorch, used to accelerate model execution on Intel CPUs."@en .
mlm:intel-ipex-gpu a skos:Concept ; skos:inScheme mlm:AcceleratorScheme ; skos:notation "intel-ipex-gpu" ; skos:prefLabel "Intel IPEX (GPU)"@en ;
    skos:definition "Intel Extension for PyTorch, used to accelerate model execution on Intel GPUs."@en .
mlm:macos-arm a skos:Concept ; skos:inScheme mlm:AcceleratorScheme ; skos:notation "macos-arm" ; skos:prefLabel "macOS ARM (Apple Silicon)"@en ;
    skos:definition "Apple Silicon (ARM-based) hardware acceleration on macOS, e.g. via Apple's Metal Performance Shaders."@en .

### mlm:resize_type (ModelInput) — closed

mlm:ResizeTypeScheme a skos:ConceptScheme ;
    dct:title "MLM Resize Types" ;
    dct:description "Spatial resizing methods a ModelInput may apply, as defined by the STAC MLM extension." ;
    rdfs:isDefinedBy mlm: .

mlm:crop a skos:Concept ; skos:inScheme mlm:ResizeTypeScheme ; skos:notation "crop" ; skos:prefLabel "Crop"@en ;
    skos:definition "Truncating the input to the required size by discarding pixels outside the target region, without rescaling."@en .
mlm:pad a skos:Concept ; skos:inScheme mlm:ResizeTypeScheme ; skos:notation "pad" ; skos:prefLabel "Pad"@en ;
    skos:definition "Extending the input to the required size by adding border pixels, without rescaling."@en .
mlm:interpolation-nearest a skos:Concept ; skos:inScheme mlm:ResizeTypeScheme ; skos:notation "interpolation-nearest" ; skos:prefLabel "Nearest-neighbor interpolation"@en ;
    skos:definition "Resampling to the required size by taking the value of the nearest source pixel for each output pixel."@en .
mlm:interpolation-linear a skos:Concept ; skos:inScheme mlm:ResizeTypeScheme ; skos:notation "interpolation-linear" ; skos:prefLabel "Linear interpolation"@en ;
    skos:definition "Resampling to the required size using (bi)linear interpolation between neighboring source pixels."@en .
mlm:interpolation-cubic a skos:Concept ; skos:inScheme mlm:ResizeTypeScheme ; skos:notation "interpolation-cubic" ; skos:prefLabel "Cubic interpolation"@en ;
    skos:definition "Resampling to the required size using (bi)cubic interpolation over a neighborhood of source pixels."@en .
mlm:interpolation-area a skos:Concept ; skos:inScheme mlm:ResizeTypeScheme ; skos:notation "interpolation-area" ; skos:prefLabel "Area interpolation"@en ;
    skos:definition "Resampling by averaging over the pixel area, generally preferred when shrinking an image."@en .
mlm:interpolation-lanczos4 a skos:Concept ; skos:inScheme mlm:ResizeTypeScheme ; skos:notation "interpolation-lanczos4" ; skos:prefLabel "Lanczos-4 interpolation"@en ;
    skos:definition "Resampling using an 8x8 pixel Lanczos windowed sinc interpolation."@en .
mlm:interpolation-max a skos:Concept ; skos:inScheme mlm:ResizeTypeScheme ; skos:notation "interpolation-max" ; skos:prefLabel "Max interpolation"@en ;
    skos:definition "Resampling by taking the maximum value over the source pixels contributing to each output pixel."@en .
mlm:wrap-fill-outliers a skos:Concept ; skos:inScheme mlm:ResizeTypeScheme ; skos:notation "wrap-fill-outliers" ; skos:prefLabel "Wrap, fill outliers"@en ;
    skos:definition "A remapping-based resize (OpenCV WRAP_FILL_OUTLIERS) that fills destination pixels not covered by the source with the nearest valid value."@en .
mlm:wrap-inverse-map a skos:Concept ; skos:inScheme mlm:ResizeTypeScheme ; skos:notation "wrap-inverse-map" ; skos:prefLabel "Wrap, inverse map"@en ;
    skos:definition "A remapping-based resize (OpenCV WRAP_INVERSE_MAP) that applies the inverse of the given mapping."@en .

### ValueScalingObject 'type' discriminator — closed

mlm:ValueScalingTypeScheme a skos:ConceptScheme ;
    dct:title "MLM Value Scaling Types" ;
    dct:description "The transformation methods a ValueScalingObject may apply to a ModelInput's values, as defined by the STAC MLM extension." ;
    rdfs:isDefinedBy mlm: .

mlm:min-max a skos:Concept ; skos:inScheme mlm:ValueScalingTypeScheme ; skos:notation "min-max" ; skos:prefLabel "Min-max scaling"@en ;
    skos:definition "Rescaling a value into a fixed range (typically [0,1]) using the mlm:minimum and mlm:maximum bounds: (value - minimum) / (maximum - minimum)."@en .
mlm:z-score a skos:Concept ; skos:inScheme mlm:ValueScalingTypeScheme ; skos:notation "z-score" ; skos:prefLabel "Z-score scaling"@en ;
    skos:definition "Standardizing a value using the mlm:mean and mlm:stddev: (value - mean) / stddev."@en .
mlm:clip a skos:Concept ; skos:inScheme mlm:ValueScalingTypeScheme ; skos:notation "clip" ; skos:prefLabel "Clip"@en ;
    skos:definition "Constraining a value to lie within the mlm:minimum and mlm:maximum bounds."@en .
mlm:clip-min a skos:Concept ; skos:inScheme mlm:ValueScalingTypeScheme ; skos:notation "clip-min" ; skos:prefLabel "Clip minimum"@en ;
    skos:definition "Constraining a value to be no less than mlm:minimum."@en .
mlm:clip-max a skos:Concept ; skos:inScheme mlm:ValueScalingTypeScheme ; skos:notation "clip-max" ; skos:prefLabel "Clip maximum"@en ;
    skos:definition "Constraining a value to be no greater than mlm:maximum."@en .
mlm:offset a skos:Concept ; skos:inScheme mlm:ValueScalingTypeScheme ; skos:notation "offset" ; skos:prefLabel "Offset"@en ;
    skos:definition "Adding a fixed mlm:scaling_value to a value."@en .
mlm:scale a skos:Concept ; skos:inScheme mlm:ValueScalingTypeScheme ; skos:notation "scale" ; skos:prefLabel "Scale"@en ;
    skos:definition "Multiplying a value by a fixed mlm:scaling_value."@en .
mlm:processing a skos:Concept ; skos:inScheme mlm:ValueScalingTypeScheme ; skos:notation "processing" ; skos:prefLabel "Processing expression"@en ;
    skos:definition "Applying an arbitrary transformation expressed as a Processing Expression, reusing the STAC Processing extension's expression shape (see mlm:pre_processing_function/mlm:post_processing_function and processing:expression)."@en ;
    skos:closeMatch <https://w3id.org/ogc/stac/processing/expression> .
