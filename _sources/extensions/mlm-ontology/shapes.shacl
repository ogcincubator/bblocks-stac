@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix mlm:   <https://w3id.org/ogc/stac/mlm/> .
@prefix cube:  <https://w3id.org/ogc/stac/datacube/> .
@prefix stac:  <https://w3id.org/ogc/stac/core/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# SHACL shapes for the STAC MLM extension vocabulary.
#
# Only constrains what the extension itself guarantees: required top-level fields
# (name, architecture, tasks, input, output), the closed enumerations (tasks,
# accelerator, resize_type, scaling_type), and the required sub-fields of
# ModelInput/ModelOutput/InputStructure/ResultStructure/ValueScaling, plus the
# cross-reference and list-position (ordering) rules that JSON Schema cannot express.

mlm:ModelRootShape a sh:NodeShape ;
    rdfs:label "MLM model root shape" ;
    sh:targetSubjectsOf mlm:input ;
    sh:property [ sh:path mlm:name ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path mlm:architecture ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [
        sh:path (mlm:tasks [ sh:zeroOrMorePath rdf:rest ] rdf:first) ;
        sh:minCount 1 ; sh:class skos:Concept
    ] ;
    sh:property [
        sh:path (mlm:input [ sh:zeroOrMorePath rdf:rest ] rdf:first) ;
        sh:minCount 1 ; sh:node mlm:ModelInputShape
    ] ;
    sh:property [
        sh:path (mlm:output [ sh:zeroOrMorePath rdf:rest ] rdf:first) ;
        sh:minCount 1 ; sh:node mlm:ModelOutputShape
    ] .

mlm:AcceleratorShape a sh:NodeShape ;
    rdfs:label "mlm:accelerator shape" ;
    sh:targetSubjectsOf mlm:accelerator ;
    sh:property [
        sh:path mlm:accelerator ; sh:maxCount 1 ;
        sh:in ( mlm:amd64 mlm:cuda mlm:xla mlm:amd-rocm mlm:intel-ipex-cpu mlm:intel-ipex-gpu mlm:macos-arm
                "null"^^rdf:JSON ) ;
    ] .

mlm:ModelInputShape a sh:NodeShape ;
    rdfs:label "mlm:ModelInput shape" ;
    sh:targetSubjectsOf mlm:input_structure ;
    sh:property [ sh:path mlm:io_name ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ] ;
    sh:property [ sh:path mlm:input_structure ; sh:minCount 1 ; sh:maxCount 1 ; sh:node mlm:InputStructureShape ] ;
    sh:property [
        sh:path mlm:resize_type ; sh:maxCount 1 ;
        sh:in ( mlm:crop mlm:pad mlm:interpolation-nearest mlm:interpolation-linear mlm:interpolation-cubic
                mlm:interpolation-area mlm:interpolation-lanczos4 mlm:interpolation-max
                mlm:wrap-fill-outliers mlm:wrap-inverse-map "null"^^rdf:JSON ) ;
    ] .

mlm:ModelOutputShape a sh:NodeShape ;
    rdfs:label "mlm:ModelOutput shape" ;
    sh:targetSubjectsOf mlm:result ;
    sh:property [ sh:path mlm:io_name ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ] ;
    sh:property [ sh:path mlm:result ; sh:minCount 1 ; sh:maxCount 1 ; sh:node mlm:ResultStructureShape ] .

mlm:BandVariableReferenceShape a sh:NodeShape ;
    rdfs:label "MLM band or variable reference shape" ;
    sh:targetSubjectsOf mlm:reference_name ;
    sh:property [ sh:path mlm:reference_name ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                 sh:minLength 1 ] ;
    sh:property [ sh:path mlm:reference_format ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path mlm:reference_expression ; sh:maxCount 1 ] .

mlm:InputStructureShape a sh:NodeShape ;
    rdfs:label "mlm:InputStructure shape" ;
    sh:targetSubjectsOf mlm:shape ;
    sh:property [ sh:path mlm:shape ; sh:minCount 1 ] ;
    sh:property [
        sh:path (mlm:shape [ sh:zeroOrMorePath rdf:rest ] rdf:first) ;
        sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:decimal ] ) ;
    ] ;
    sh:property [ sh:path mlm:dim_order ; sh:minCount 1 ] ;
    sh:property [
        sh:path (mlm:dim_order [ sh:zeroOrMorePath rdf:rest ] rdf:first) ;
        sh:datatype xsd:string ;
    ] .

mlm:ResultStructureShape a sh:NodeShape ;
    rdfs:label "mlm:ResultStructure shape" ;
    sh:targetSubjectsOf mlm:shape ;
    sh:property [ sh:path mlm:shape ; sh:minCount 1 ] ;
    sh:property [
        sh:path (mlm:shape [ sh:zeroOrMorePath rdf:rest ] rdf:first) ;
        sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] [ sh:datatype xsd:decimal ] ) ;
    ] ;
    sh:property [ sh:path mlm:dim_order ; sh:minCount 1 ] ;
    sh:property [
        sh:path (mlm:dim_order [ sh:zeroOrMorePath rdf:rest ] rdf:first) ;
        sh:datatype xsd:string ;
    ] .

mlm:ValueScalingShape a sh:NodeShape ;
    rdfs:label "mlm:ValueScaling shape" ;
    sh:targetSubjectsOf mlm:scaling_type ;
    sh:property [
        sh:path mlm:scaling_type ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ;
        sh:in ( mlm:min-max mlm:z-score mlm:clip mlm:clip-min mlm:clip-max mlm:offset mlm:scale mlm:processing ) ;
    ] .

mlm:VariableReferenceResolutionShape a sh:NodeShape ;
    rdfs:label "MLM variable reference resolution shape" ;
    sh:targetSubjectsOf mlm:variables ;
    sh:sparql [
        sh:message "Every MLM variable reference must resolve to a key in the enclosing Item or Asset Datacube cube:variables map." ;
        sh:select """
            SELECT $this ?reference
            WHERE {
                $this mlm:variables/rdf:rest*/rdf:first ?reference .
                OPTIONAL { ?reference mlm:reference_name ?referenceName }
                BIND (IF(isLiteral(?reference), STR(?reference), ?referenceName) AS ?name)
                FILTER NOT EXISTS {
                    ?model ?inputOutput ?inputsOutputs .
                    FILTER (?inputOutput IN (mlm:input, mlm:output))
                    ?inputsOutputs rdf:rest*/rdf:first $this .
                    ?source cube:variables ?variable .
                    FILTER (
                        ?source = ?model
                        || EXISTS { ?model stac:hasAsset ?source }
                        || EXISTS {
                            ?item <https://w3id.org/ogc/stac/mlm/serialization/member/properties> ?model ;
                                  stac:hasAsset ?source
                        }
                    )
                    ?variable mlm:datacube_variable_name ?name
                }
            }
        """
    ] .

mlm:VariableDimensionResolutionShape a sh:NodeShape ;
    rdfs:label "Datacube variable dimension resolution shape" ;
    sh:targetSubjectsOf cube:variables ;
    sh:sparql [
        sh:message "Every dimension named by a Datacube variable must resolve to a key in cube:dimensions on the same resource." ;
        sh:select """
            SELECT $this ?dimension
            WHERE {
                $this cube:variables ?variable .
                ?variable cube:dimensions/(rdf:rest*/rdf:first)? ?dimension .
                FILTER (isLiteral(?dimension))
                FILTER NOT EXISTS {
                    $this cube:dimensions ?dimensionDefinition .
                    ?dimensionDefinition mlm:datacube_dimension_name ?dimension
                }
            }
        """
    ] .


# Ordering constraints.
#
# MLM arrays are RDF lists because their positions carry meaning: mlm:shape[i] is the size of the
# axis named mlm:dim_order[i], and mlm:bands / mlm:variables supply the element order along the
# reserved "bands" / "variables" axes. The constraints below reject definitions whose positions can
# no longer be aligned, which JSON Schema alone cannot express.

mlm:TensorStructureOrderShape a sh:NodeShape ;
    rdfs:label "MLM tensor structure order shape" ;
    sh:targetSubjectsOf mlm:dim_order ;
    sh:sparql [
        sh:message "mlm:shape has {?shapeLength} entries but mlm:dim_order has {?dimensionLength}: each shape size must be named by the dim_order entry at the same position." ;
        sh:select """
            SELECT $this ?shapeLength ?dimensionLength
            WHERE {
                {
                    SELECT $this (COUNT(?sizeNode) AS ?shapeLength)
                    WHERE { $this mlm:shape/rdf:rest* ?sizeNode . ?sizeNode rdf:first ?size }
                    GROUP BY $this
                }
                {
                    SELECT $this (COUNT(?dimensionNode) AS ?dimensionLength)
                    WHERE { $this mlm:dim_order/rdf:rest* ?dimensionNode . ?dimensionNode rdf:first ?dimension }
                    GROUP BY $this
                }
                FILTER (?shapeLength != ?dimensionLength)
            }
        """
    ] ;
    sh:sparql [
        sh:message "mlm:shape size {?size} is invalid: each dimension size must be greater than 0, or -1 for a variable size." ;
        sh:select """
            SELECT $this ?size
            WHERE {
                $this mlm:shape/rdf:rest*/rdf:first ?size .
                FILTER (?size = 0 || ?size < -1)
            }
        """
    ] ;
    sh:sparql [
        sh:message "mlm:dim_order repeats the dimension name '{?dimension}': each axis must be uniquely named." ;
        sh:select """
            SELECT DISTINCT $this ?dimension
            WHERE {
                $this mlm:dim_order/rdf:rest* ?firstNode .
                ?firstNode rdf:first ?dimension ;
                           rdf:rest+ ?laterNode .
                ?laterNode rdf:first ?laterDimension .
                FILTER (STR(?dimension) = STR(?laterDimension))
            }
        """
    ] .

mlm:StackedReferenceOrderShape a sh:NodeShape ;
    rdfs:label "MLM stacked band/variable order shape" ;
    sh:targetSubjectsOf mlm:input_structure, mlm:result ;
    sh:sparql [
        sh:message "The reserved dim_order axis '{?axis}' must be present if and only if the corresponding mlm:{?axis} list is non-empty, since that list supplies the element order along the axis." ;
        sh:select """
            SELECT $this ?axis
            WHERE {
                { BIND ("bands" AS ?axis) BIND (mlm:bands AS ?referenceProperty) }
                UNION
                { BIND ("variables" AS ?axis) BIND (mlm:variables AS ?referenceProperty) }
                $this mlm:input_structure|mlm:result ?structure .
                BIND (EXISTS { $this ?referenceProperty ?references . ?references rdf:first ?reference } AS ?hasReferences)
                BIND (EXISTS {
                    ?structure mlm:dim_order/rdf:rest*/rdf:first ?dimension .
                    FILTER (STR(?dimension) = ?axis)
                } AS ?hasAxis)
                FILTER (?hasReferences != ?hasAxis)
            }
        """
    ] ;
    sh:sparql [
        sh:message "The '{?axis}' axis has size {?size} in mlm:shape but mlm:{?axis} lists {?referenceCount} entries. Without a processing function changing the stacked size, entry i of the list must describe index i of that axis." ;
        sh:select """
            SELECT $this ?axis ?size ?referenceCount
            WHERE {
                { BIND ("bands" AS ?axis) BIND (mlm:bands AS ?referenceProperty) }
                UNION
                { BIND ("variables" AS ?axis) BIND (mlm:variables AS ?referenceProperty) }
                FILTER NOT EXISTS {
                    $this mlm:pre_processing_function|mlm:post_processing_function ?function .
                    FILTER (STR(?function) != "null" && ?function != rdf:nil)
                }
                {
                    SELECT $this ?referenceProperty (COUNT(?referenceNode) AS ?referenceCount)
                    WHERE {
                        $this ?referenceProperty ?references .
                        FILTER (?referenceProperty IN (mlm:bands, mlm:variables))
                        ?references rdf:rest* ?referenceNode .
                        ?referenceNode rdf:first ?reference .
                    }
                    GROUP BY $this ?referenceProperty
                }
                {
                    SELECT $this ?axisName (COUNT(?dimensionPrefix) AS ?position)
                    WHERE {
                        $this (mlm:input_structure|mlm:result)/mlm:dim_order ?dimensions .
                        ?dimensions rdf:rest* ?dimensionPrefix .
                        ?dimensionPrefix rdf:rest* ?dimensionNode .
                        ?dimensionNode rdf:first ?axisName .
                    }
                    GROUP BY $this ?dimensionNode ?axisName
                }
                {
                    SELECT $this ?size (COUNT(?sizePrefix) AS ?position)
                    WHERE {
                        $this (mlm:input_structure|mlm:result)/mlm:shape ?sizes .
                        ?sizes rdf:rest* ?sizePrefix .
                        ?sizePrefix rdf:rest* ?sizeNode .
                        ?sizeNode rdf:first ?size .
                    }
                    GROUP BY $this ?sizeNode ?size
                }
                FILTER (STR(?axisName) = ?axis && ?size != -1 && ?size != ?referenceCount)
            }
        """
    ] .

mlm:ValueScalingOrderShape a sh:NodeShape ;
    rdfs:label "MLM value scaling order shape" ;
    sh:targetSubjectsOf mlm:value_scaling ;
    sh:sparql [
        sh:message "mlm:value_scaling has {?scalingCount} entries, which matches no stacked bands/variables/channel axis size ({?axisSizes}). Provide one entry to broadcast, or one entry per axis element in the same order." ;
        sh:select """
            SELECT $this ?scalingCount (GROUP_CONCAT(DISTINCT STR(?size); separator=", ") AS ?axisSizes)
            WHERE {
                {
                    SELECT $this (COUNT(?scalingNode) AS ?scalingCount)
                    WHERE {
                        $this mlm:value_scaling ?scalings .
                        ?scalings rdf:rest* ?scalingNode .
                        ?scalingNode rdf:first ?scaling .
                    }
                    GROUP BY $this
                }
                FILTER (?scalingCount > 1)
                {
                    SELECT $this ?axisName (COUNT(?dimensionPrefix) AS ?position)
                    WHERE {
                        $this mlm:input_structure/mlm:dim_order ?dimensions .
                        ?dimensions rdf:rest* ?dimensionPrefix .
                        ?dimensionPrefix rdf:rest* ?dimensionNode .
                        ?dimensionNode rdf:first ?axisName .
                    }
                    GROUP BY $this ?dimensionNode ?axisName
                }
                {
                    SELECT $this ?size (COUNT(?sizePrefix) AS ?position)
                    WHERE {
                        $this mlm:input_structure/mlm:shape ?sizes .
                        ?sizes rdf:rest* ?sizePrefix .
                        ?sizePrefix rdf:rest* ?sizeNode .
                        ?sizeNode rdf:first ?size .
                    }
                    GROUP BY $this ?sizeNode ?size
                }
                FILTER (STR(?axisName) IN ("bands", "variables", "channel") && ?size != -1)
            }
            GROUP BY $this ?scalingCount
            HAVING (SUM(IF(?size = ?scalingCount, 1, 0)) = 0)
        """
    ] .

mlm:ModelAssetShape a sh:NodeShape ;
    rdfs:label "MLM model asset shape" ;
    sh:targetSubjectsOf mlm:artifact_type ;
    sh:sparql [
        sh:message "An asset with mlm:artifact_type must also carry the mlm:model role." ;
        sh:select """
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this stac:hasAssetroles/(rdf:rest*/rdf:first)? ?role .
                    FILTER (STR(?role) = "mlm:model")
                }
            }
        """
    ] .
