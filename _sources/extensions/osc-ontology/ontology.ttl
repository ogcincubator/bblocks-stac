@prefix osc:  <https://w3id.org/ogc/stac/osc/> .
@prefix stac: <https://w3id.org/ogc/stac/core/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ontology Metadata
#################################################################

osc: a owl:Ontology ;
    dct:title "STAC ESA Open Science Catalog (OSC) Extension Ontology" ;
    dct:description """Vocabulary for the elements defined by the STAC OSC extension: classifying a STAC resource as an OSC project or product, and describing its status, region, variables, missions and workflows.

This ontology describes only the osc:* fields that the extension adds. STAC Item, Collection and Catalog are defined by the STAC core vocabulary and are reused — not redefined — here.

Replaces an earlier placeholder version of this block, which incorrectly declared its owl:Ontology IRI as a copy of the STAC core ontology namespace (https://w3id.org/ogc/stac/core/) and described none of the OSC extension's own elements.

Combines skos.ttl (osc:ResourceTypeScheme and osc:StatusScheme, the extension's fixed enumerations) and owl.ttl (the osc:* datatype properties).""" ;
    dct:source <https://github.com/stac-extensions/osc/tree/v1.0.0> ;
    dct:creator "Rob Atkinson, OGC" ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:versionInfo "1.0.0" .

#################################################################
# SKOS component — osc:type and osc:status
# (component source: skos.ttl)
#################################################################

osc:ResourceTypeScheme a skos:ConceptScheme ;
    dct:title "OSC Resource Types" ;
    dct:description "The fixed set of ESA Open Science Catalog resource types: whether a STAC resource represents a project or a product." ;
    rdfs:isDefinedBy osc: .

osc:project-type a skos:Concept ;
    skos:inScheme osc:ResourceTypeScheme ;
    skos:notation "project" ;
    skos:prefLabel "Project"@en ;
    skos:definition "A thematic science initiative, typically bound to a region, that develops workflows and produces products."@en .

osc:product-type a skos:Concept ;
    skos:inScheme osc:ResourceTypeScheme ;
    skos:notation "product" ;
    skos:prefLabel "Product"@en ;
    skos:definition "An output of a project: data produced by running one of its workflows/experiments."@en .

osc:StatusScheme a skos:ConceptScheme ;
    dct:title "OSC Status" ;
    dct:description "The fixed set of lifecycle states an OSC project or product may be in." ;
    rdfs:isDefinedBy osc: .

# The extension's schema gives only the enum values themselves and a one-line description of the
# osc:status field as a whole ("Indicates if work is planned, ongoing, or completed") — no separate
# prose per value. The definitions below are a faithful, minimal reading of each value in that context,
# not additional spec text (there is none to copy).

osc:planned a skos:Concept ;
    skos:inScheme osc:StatusScheme ;
    skos:notation "planned" ;
    skos:prefLabel "Planned"@en ;
    skos:definition "Work on the project or product has not yet started."@en .

osc:ongoing a skos:Concept ;
    skos:inScheme osc:StatusScheme ;
    skos:notation "ongoing" ;
    skos:prefLabel "Ongoing"@en ;
    skos:definition "Work on the project or product is actively in progress."@en .

osc:completed a skos:Concept ;
    skos:inScheme osc:StatusScheme ;
    skos:notation "completed" ;
    skos:prefLabel "Completed"@en ;
    skos:definition "Work on the project or product has finished."@en .

#################################################################
# OWL component — the osc:* datatype properties
# (component source: owl.ttl)
#################################################################

osc:type a owl:DatatypeProperty ;
    rdfs:label "OSC resource type" ;
    dct:description "REQUIRED. Specifies whether the resource is a 'project' or a 'product', drawn from the fixed osc:ResourceTypeScheme vocabulary." ;
    rdfs:comment "Range is skos:Concept: the value is one of osc:ResourceTypeScheme's members (osc:project-type, osc:product-type), addressed by its skos:notation string in JSON." ;
    rdfs:domain [ owl:unionOf (stac:Item stac:Collection stac:Catalog) ] ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy osc: .

osc:status a owl:DatatypeProperty ;
    rdfs:label "OSC status" ;
    dct:description "REQUIRED. The lifecycle state of the project or product, drawn from the fixed osc:StatusScheme vocabulary." ;
    rdfs:comment "Range is skos:Concept: the value is one of osc:StatusScheme's members (osc:planned, osc:ongoing, osc:completed), addressed by its skos:notation string in JSON." ;
    rdfs:domain [ owl:unionOf (stac:Item stac:Collection stac:Catalog) ] ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy osc: .

osc:project a owl:DatatypeProperty ;
    rdfs:label "OSC project" ;
    dct:description "REQUIRED on products. Names the science initiative (Project) a product belongs to." ;
    rdfs:domain [ owl:unionOf (stac:Item stac:Collection) ] ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy osc: .

osc:region a owl:DatatypeProperty ;
    rdfs:label "OSC region" ;
    dct:description "The geographic area associated with the project/product, e.g. 'Arctic' or 'Agulhas'." ;
    rdfs:domain [ owl:unionOf (stac:Item stac:Collection) ] ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy osc: .

osc:variables a owl:DatatypeProperty ;
    rdfs:label "OSC variables" ;
    dct:description "Observable physical phenomena tracked by the product, e.g. 'Wind stress'." ;
    rdfs:domain [ owl:unionOf (stac:Item stac:Collection) ] ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy osc: .

osc:missions a owl:DatatypeProperty ;
    rdfs:label "OSC missions" ;
    dct:description "Satellite missions that supplied input data for the product." ;
    rdfs:domain [ owl:unionOf (stac:Item stac:Collection) ] ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy osc: .

osc:experiment a owl:DatatypeProperty ;
    rdfs:label "OSC experiment" ;
    dct:description "The name of the specific workflow execution that generated the product." ;
    rdfs:domain [ owl:unionOf (stac:Item stac:Collection) ] ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy osc: .

osc:workflows a owl:DatatypeProperty ;
    rdfs:label "OSC workflows" ;
    dct:description "Processing pipelines developed within the project context." ;
    rdfs:domain stac:Collection ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy osc: .
