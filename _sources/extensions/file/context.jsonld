{
  "@context": {
    "file": "https://w3id.org/ogc/stac/file/",
    "file:byte_order": { "@id": "file:byte_order", "@type": "xsd:string" },
    "file:checksum": { "@id": "file:checksum", "@type": "xsd:string" },
    "file:header_size": { "@id": "file:header_size", "@type": "xsd:nonNegativeInteger" },
    "file:size": { "@id": "file:size", "@type": "xsd:nonNegativeInteger" },
    "file:values": { "@id": "file:values", "@type": "@json" },
    "file:local_path": { "@id": "file:local_path", "@type": "xsd:string" }
  }
}
