@prefix processing: <https://w3id.org/ogc/stac/processing/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ontology Metadata
#################################################################

processing: a owl:Ontology ;
    dct:title "STAC Processing Extension Ontology" ;
    dct:description """Vocabulary for the elements defined by the STAC Processing extension: it indicates from which processing chain data originates and how the data itself has been produced.

This ontology describes only the processing:* fields that the extension adds. STAC Item, Collection and Asset (and their core fields) are defined by the STAC core vocabulary and are reused — not redefined — here; the Processing schema block inherits them through its bblocks://ogc.contrib.stac.item and bblocks://ogc.contrib.stac.collection imports.""" ;
    dct:source <https://github.com/stac-extensions/processing/tree/v1.2.0> ;
    dct:creator "Rob Atkinson, OGC" ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:versionInfo "1.2.0" .

#################################################################
# Properties — the elements the Processing extension defines
#################################################################

processing:expression a owl:DatatypeProperty ;
    rdfs:label "processing expression" ;
    dct:description "An expression or processing chain that describes how the data has been processed. Serialized as an Expression Object with a 'format' (the type of the expression) and an 'expression' value compliant with that format." ;
    rdfs:range rdf:JSON ;
    rdfs:comment "Carried as an opaque JSON object in the JSON-LD mapping (@json); its internal 'format'/'expression' members are not uplifted to separate triples." ;
    rdfs:isDefinedBy processing: .

processing:lineage a owl:DatatypeProperty ;
    rdfs:label "processing lineage" ;
    dct:description "Lineage Information provided as free text information about how observations were processed or which models were used to create the resource being described." ;
    rdfs:range xsd:string ;
    skos:closeMatch dct:provenance ;
    rdfs:isDefinedBy processing: .

processing:level a owl:DatatypeProperty ;
    rdfs:label "processing level" ;
    dct:description "The name commonly used to refer to the processing level, to make it easier to search for product level across collections or items." ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy processing: .

processing:facility a owl:DatatypeProperty ;
    rdfs:label "processing facility" ;
    dct:description "The name of the facility that produced the data." ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy processing: .

processing:datetime a owl:DatatypeProperty ;
    rdfs:label "processing datetime" ;
    dct:description "Processing date and time of the corresponding data, formatted according to RFC 3339, section 5.6, in UTC." ;
    rdfs:range xsd:dateTime ;
    skos:closeMatch prov:generatedAtTime ;
    rdfs:isDefinedBy processing: .

processing:version a owl:DatatypeProperty ;
    rdfs:label "processing version" ;
    dct:description "The version of the primary processing software or processing chain that produced the data." ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy processing: .

processing:software a owl:DatatypeProperty ;
    rdfs:label "processing software" ;
    dct:description "A dictionary with name/version for key/value describing one or more applications or libraries involved during data production for provenance purposes." ;
    rdfs:range rdf:JSON ;
    rdfs:comment "Carried as an opaque JSON object (a name→version map) in the JSON-LD mapping (@json); individual name/version pairs are not uplifted to separate triples." ;
    rdfs:isDefinedBy processing: .
