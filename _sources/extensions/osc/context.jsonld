{
  "@context": {
    "osc": "https://w3id.org/ogc/stac/osc/",
    "osc:type": {
      "@id": "osc:type",
      "@type": "@vocab",
      "@context": { "project": "osc:project-type", "product": "osc:product-type" }
    },
    "osc:status": {
      "@id": "osc:status",
      "@type": "@vocab",
      "@context": { "planned": "osc:planned", "ongoing": "osc:ongoing", "completed": "osc:completed" }
    },
    "osc:project": { "@id": "osc:project", "@type": "xsd:string" },
    "osc:region": { "@id": "osc:region", "@type": "xsd:string" },
    "osc:variables": { "@id": "osc:variables", "@type": "xsd:string", "@container": "@set" },
    "osc:missions": { "@id": "osc:missions", "@type": "xsd:string", "@container": "@set" },
    "osc:experiment": { "@id": "osc:experiment", "@type": "xsd:string" },
    "osc:workflows": { "@id": "osc:workflows", "@type": "xsd:string", "@container": "@set" }
  }
}
